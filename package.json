{
  "name": "setup-cursor-action",
  "version": "0.0.1.beta.0",
  "packageManager": "pnpm@10.17.1",
  "description": "GitHub Action for setting up Cursor Agent CLI",
  "author": "Chizuki <chizukicn@outlook.com>",
  "license": "MIT",
  "repository": "chizukicn/setup-cursor-action",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "lint": "eslint --cache -f mo",
    "lint:fix": "pnpm lint --fix",
    "prepare": "npx simple-git-hooks",
    "prepack": "pnpm run build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "vitest run --coverage",
    "up:deps": "taze major",
    "up:polyfill": "nolyfill install"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@curev/eslint-config": "^0.6.0",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.1",
    "eslint-formatter-mo": "^2.3.0",
    "lint-staged": "^16.2.1",
    "nolyfill": "^1.0.44",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.15.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "array-includes": "npm:@nolyfill/array-includes@^1.0.44",
      "array.prototype.flat": "npm:@nolyfill/array.prototype.flat@^1.0.44",
      "array.prototype.flatmap": "npm:@nolyfill/array.prototype.flatmap@^1.0.44",
      "has": "npm:@nolyfill/has@^1.0.44",
      "is-core-module": "npm:@nolyfill/is-core-module@^1.0.39",
      "object.values": "npm:@nolyfill/object.values@^1.0.44"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --cache --fix"
    ]
  }
}
